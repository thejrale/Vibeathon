# Copy to deploy/.env (git-ignored). Never commit real values.

# Common
CENTRAL_DOMAIN=
ADMIN_EMAIL=

# Path A: existing server
SERVER_IP=
SSH_USER=
SSH_KEY_PATH=

# Path B: pick one provider
PROVIDER=            # digitalocean | aws | gcp
REGION=
# DIGITALOCEAN_TOKEN=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GCP_PROJECT=

# Backups (off-server)
BACKUP_TARGET=       # s3://bucket/path, gs://bucket/path, or user@host:/path
