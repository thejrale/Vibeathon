# Copy to deploy/.env (git-ignored). Never commit real values.

# Common
CENTRAL_DOMAIN=
ADMIN_EMAIL=

# Path A: existing server
SERVER_IP=
SSH_USER=
SSH_KEY_PATH=
CENTRAL_VERSION=v2026.3.2   # getodk/central release tag
# SUDO_PASSWORD: export in your shell only if sudo asks for a password

# Path B: pick one provider
PROVIDER=            # digitalocean | aws | gcp
REGION=
# DIGITALOCEAN_TOKEN=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GCP_PROJECT=

# Backups (off-server)
BACKUP_TARGET=       # rclone remote:path configured on the server, e.g. offsite:odk-backups
